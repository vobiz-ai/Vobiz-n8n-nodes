        "numbers": [],
        "message": "Welcome to the n8n test menu. Press 1 to talk to an agent. Press 2 to hear our opening hours. Press 3 to leave a message.",
        "voice": "WOMAN",
        "language": "en-GB",
        "then": "menu",
        "menuChoices": {
          "choice": [
            {
              "key": "1",
              "action": "forward",
              "reply": "Connecting you to an agent.",
              "forwardTo": ""
            },
            {
              "key": "2",
              "action": "say",
              "reply": "We are open from 9 in the morning to 6 in the evening, Monday to Friday. Goodbye."
            },
            {
              "key": "3",
              "action": "voicemail",
              "reply": "Please leave a message after the beep, and press hash when you are done."
            }
          ]
        },
        "ifNoAnswer": "voicemail",
        "forwardOptions": {
          "ringSeconds": 20
        },
        "options": {}
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000040",
