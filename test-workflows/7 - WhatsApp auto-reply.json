{
  "name": "Vobiz test 7 - WhatsApp auto-reply",
  "nodes": [
    {
      "id": "00000000-0000-4000-8000-000000000019",
      "name": "Vobiz WhatsApp Trigger",
      "type": "CUSTOM.vobizWhatsAppTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "webhookId": "7b2c3d4e-5f60-4a71-8b92-a3b4c5d6e7f8",
      "parameters": {
        "events": [
          "message.inbound"
        ],
        "channel": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "simplify": true
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000020",
      "name": "Only My Phone",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "5f0c2b1a-8d3e-4c6f-9a7b-2e1d0c9b8a71",
              "leftValue": "={{ $json.from }}",
              "rightValue": "YOUR-MOBILE-DIGITS",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000021",
      "name": "Reply",
      "type": "CUSTOM.vobiz",
      "typeVersion": 1,
      "position": [
        520,
        0
      ],
      "parameters": {
        "resource": "whatsAppMessage",
        "operation": "send",
        "channel": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "to": "={{ $json.from }}",
        "messageType": "text",
        "text": "=Thanks {{ $json.name }}! We got your message: \"{{ $json.text }}\""
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000022",
      "name": "Note 22",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -400
      ],
      "parameters": {
        "content": "## Test 7: WhatsApp auto-reply\n1. Pick the WhatsApp account's **Credential** in both Vobiz nodes, and the same **Channel** in both.\n2. **Only My Phone** lets through messages from your number (replace YOUR-MOBILE-DIGITS) only, so nobody else gets a test reply.\n3. **Publish** the workflow.\n4. From your phone, send a WhatsApp message to your business number. A reply comes back.\n5. **Unpublish** when you're done.",
        "width": 520,
        "height": 360
      }
    }
  ],
  "connections": {
    "Vobiz WhatsApp Trigger": {
      "main": [
        [
          {
            "node": "Only My Phone",
            "type": "main",
            "index": 0
          }
        ]
