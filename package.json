{
	"name": "@vobiz-ai/n8n-nodes-vobiz",
	"version": "0.2.0",
	"description": "n8n nodes for Vobiz: make calls, answer them with menus, forwarding and voicemail, get call records and recordings, send WhatsApp messages, manage sub-accounts and their KYC, and start workflows from calls, WhatsApp messages and KYC results.",
	"license": "MIT",
	"homepage": "https://www.vobiz.ai",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"vobiz",
		"voice",
		"telephony",
		"whatsapp",
		"cdr",
		"call recording",
		"sub-account",
		"kyc",
		"ivr",
		"voicemail"
	],
	"author": {
		"name": "Vobiz AI",
		"email": "support@vobiz.ai"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vobiz-ai/Vobiz-n8n-nodes.git"
	},
	"bugs": {
		"url": "https://github.com/vobiz-ai/Vobiz-n8n-nodes/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "npm run build && node --test \"test/*.test.js\"",
		"test:e2e": "npm run build && node test/e2e/run-e2e.js",
		"n8n": "node scripts/start-n8n.js"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/VobizApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Vobiz/Vobiz.node.js",
			"dist/nodes/VobizTrigger/VobizTrigger.node.js",
			"dist/nodes/VobizCallAnsweredTrigger/VobizCallAnsweredTrigger.node.js",
			"dist/nodes/VobizWhatsAppTrigger/VobizWhatsAppTrigger.node.js",
			"dist/nodes/VobizKycTrigger/VobizKycTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
