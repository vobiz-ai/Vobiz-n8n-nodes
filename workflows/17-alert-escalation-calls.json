          {
            "node": "On-call did not answer?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "On-call did not answer?": {
      "main": [
        [
          {
            "node": "Call the backup engineer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
